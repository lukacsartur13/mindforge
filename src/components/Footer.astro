---
import { NAV, SITE, stripBase } from '../config';
import SocialIcons from './SocialIcons.astro';
import LazyVideo from './LazyVideo.astro';
import Img from './Img.astro';
import poster from '../assets/img/footer-video-poster.jpg';
import logo from '../assets/img/logo.png';
const year = new Date().getFullYear();
const path = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
---
<footer class="site-footer">
  <LazyVideo class="site-footer__video" src="/assets/video/footer.mp4" poster={poster} />
  <div class="site-footer__inner">
    <a href="/" class="site-footer__logo" aria-label="Mindforge – főoldal">
      <Img src={logo} alt="MINDFORGE sport mentáltréning" sizes="(max-width: 900px) 200px, 270px" widths={[200, 270, 400, 540]} />
    </a>

    <address class="site-footer__contact">
      {SITE.owner}<br />
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
      <a href={SITE.phoneHref}>{SITE.phone}</a><br />
      Sport mentáltréning Győrben, Budapesten és online
    </address>

    <div class="site-footer__links">
      <ul class="site-footer__nav">
        {NAV.map((item) => (
          <li><a href={item.href} class:list={{ 'is-active': item.href === path }}>{item.footerLabel}</a></li>
        ))}
      </ul>
      <ul class="site-footer__legal">
        <li><a href="/adatkezelesi-nyilatkozat">Adatkezelési Nyilatkozat</a></li>
        <li><a href="/impresszum">Impresszum</a></li>
      </ul>
    </div>

    <div class="site-footer__bottom">
      <SocialIcons class="site-footer__social" long />
      <p class="site-footer__copy">
        © {year} by MINDFORGE. Készítette és fenntartja:{" "}
        <a href="https://www.stratosweb.hu/" target="_blank" rel="noopener">STRATOS MEDIA AGENCY</a>
      </p>
    </div>
  </div>
</footer>
