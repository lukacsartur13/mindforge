---
import fontsUrl from '../styles/fonts.css?url';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, IS_PREVIEW, abs } from '../config';

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  /** Megosztási kép: public/ útvonal vagy importált kép */
  image?: string | ImageMetadata;
  imageAlt?: string;
  /** 'overlay' = átlátszó fejléc a hero kép fölött, 'solid' = fekete sáv */
  header?: 'overlay' | 'solid';
  type?: 'website' | 'article';
  /** Morzsamenü a strukturált adatokhoz (a főoldalt nem kell megadni) */
  breadcrumbs?: Crumb[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description,
  image = '/assets/img/og-image.jpg',
  imageAlt = 'MINDFORGE – sport mentáltréning',
  header = 'solid',
  type = 'website',
  breadcrumbs,
  jsonLd,
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonical = abs(Astro.url.pathname);

let ogImage: string;
let ogWidth = 1200;
let ogHeight = 630;
if (typeof image === 'string') {
  ogImage = abs(image);
} else {
  const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
  ogImage = abs(og.src);
}

const personId = `${SITE.url}/rolam#seregely-edit`;
const businessId = `${SITE.url}/#mindforge`;

const siteLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: 'MINDFORGE',
    inLanguage: 'hu-HU',
    publisher: { '@id': businessId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': businessId,
    name: 'MINDFORGE – Seregély Edit sport mentáltréner',
    alternateName: ['Mindforge', 'Mentális Erő'],
    description:
      'Sport mentáltréning, sportcoaching és NLP coaching sportolóknak, sportszülőknek, edzőknek és sportcsapatoknak Győrben, Budapesten és online.',
    slogan: 'Ahol a gondolkodásból teljesítmény születik',
    url: SITE.url,
    image: new URL('/assets/img/seregely-edit.jpg', SITE.url).href,
    logo: new URL('/assets/img/logo.png', SITE.url).href,
    email: SITE.email,
    telephone: SITE.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.city,
      postalCode: SITE.address.zip,
      addressCountry: SITE.address.country,
    },
    areaServed: [
      { '@type': 'City', name: 'Győr' },
      { '@type': 'City', name: 'Budapest' },
      { '@type': 'Country', name: 'Magyarország' },
    ],
    availableChannel: { '@type': 'ServiceChannel', serviceType: 'Személyes és online konzultáció' },
    knowsAbout: [
      'sport mentáltréning',
      'sportcoaching',
      'NLP coaching',
      'versenydrukk kezelése',
      'önbizalom fejlesztése',
      'fókusz és koncentráció',
      'csapatcoaching',
      'sportszülő tanácsadás',
    ],
    founder: { '@id': personId },
    sameAs: [SITE.instagram, SITE.facebook],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: SITE.owner,
    jobTitle: SITE.role,
    url: abs('/rolam'),
    image: new URL('/assets/img/seregely-edit.jpg', SITE.url).href,
    worksFor: { '@id': businessId },
    memberOf: { '@type': 'Organization', name: 'International Coaching Federation (ICF)' },
    hasCredential: {
      '@type': 'EducationalOccupationalCredential',
      name: 'ICF Sport Mental Coach',
      recognizedBy: { '@type': 'Organization', name: 'International Coaching Federation' },
    },
    sameAs: [SITE.instagram, SITE.facebook],
  },
];

const breadcrumbLd = breadcrumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Főoldal', href: '/' }, ...breadcrumbs].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: abs(c.href),
  })),
};

const extraLd = [breadcrumbLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])].filter(Boolean);
---
<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex || IS_PREVIEW ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="author" content={SITE.owner} />
    <meta name="theme-color" content="#000000" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="MINDFORGE blog" href="/rss.xml" />

    <meta property="og:site_name" content="MINDFORGE" />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={SITE.owner} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />

    <!-- Betűtípusok az első kirajzolás után (lásd styles/fonts.css) -->
    <script is:inline define:vars={{ fontsUrl }}>
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          const l = document.createElement('link');
          l.rel = 'stylesheet';
          l.href = fontsUrl;
          document.head.append(l);
        }),
      );
    </script>
    <noscript><link rel="stylesheet" href={fontsUrl} /></noscript>

    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    {extraLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body class={header === 'solid' ? 'has-solid-header' : ''}>
    <a class="skip-link" href="#tartalom">Ugrás a tartalomra</a>
    <Header variant={header} />
    <main id="tartalom">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/main.ts"></script>
  </body>
</html>
