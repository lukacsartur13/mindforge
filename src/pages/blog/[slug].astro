---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Img from '../../components/Img.astro';
import { SITE, abs } from '../../config';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      // Ajánlott posztok: előbb az azonos kategóriából, aztán a legfrissebbek
      related: posts
        .filter((p) => p.id !== post.id)
        .sort((a, b) => Number(b.data.category === post.data.category) - Number(a.data.category === post.data.category))
        .slice(0, 3),
    },
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('hu-HU', { year: 'numeric', month: 'long', day: 'numeric' });
const url = abs(`/blog/${post.id}`);
const cover = await getImage({ src: post.data.cover, width: 1200, format: 'jpg' });

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: abs(cover.src),
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { '@id': `${SITE.url}/rolam#seregely-edit` },
  publisher: { '@id': `${SITE.url}/#mindforge` },
  mainEntityOfPage: url,
  inLanguage: 'hu-HU',
  ...(post.data.category === 'mentalis-pillerek' && { isPartOf: { '@type': 'CreativeWorkSeries', name: 'Mentális pillérek' } }),
};
---
<BaseLayout
  title={post.data.seoTitle ?? `${post.data.title} | MINDFORGE`}
  description={post.data.description}
  image={post.data.cover}
  imageAlt={post.data.coverAlt || post.data.title}
  type="article"
  publishedTime={post.data.date}
  modifiedTime={post.data.updated}
  breadcrumbs={[
    { name: 'Blog', href: '/blog' },
    { name: post.data.title, href: `/blog/${post.id}` },
  ]}
  jsonLd={articleLd}
>
  <article class="post">
    <nav class="breadcrumb" aria-label="Morzsamenü">
      <a href="/">Főoldal</a> <span aria-hidden="true">/</span>
      <a href="/blog">Blog</a>
      {post.data.category === 'mentalis-pillerek' && (
        <>
          <span aria-hidden="true">/</span> <a href="/blog/kategoria/mentalis-pillerek">Mentális Pillérek</a>
        </>
      )}
    </nav>
    <p class="post__meta">
      <a href="/rolam" rel="author">{SITE.owner}</a> · <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time> · {post.data.readingTime} perc olvasás
    </p>
    <h1>{post.data.title}</h1>
    <Img class="post__cover" src={post.data.cover} alt={post.data.coverAlt} loading="eager" fetchpriority="high" sizes="(max-width: 820px) 100vw, 740px" widths={[480, 740, 1200]} />
    <div class="prose">
      <Content />
    </div>

    <aside class="post-cta" aria-labelledby="post-cta-title">
      <h2 id="post-cta-title">Szeretnél fejben is erősebb lenni?</h2>
      <p>
        Sport mentáltrénerként sportolóknak, sportszülőknek, edzőknek és csapatoknak segítek – személyesen Győrben
        vagy Budapesten, illetve online. Az első konzultáció ingyenes.
      </p>
      <a class="btn btn--black" href="/#kapcsolat">Ingyenes konzultáció</a>
    </aside>

    <aside class="author-box">
      <p>
        <strong><a href="/rolam">{SITE.owner}</a></strong> – sport mentáltréner, sportcoach, NLP Mester coach, az
        International Coaching Federation (ICF) tagja.
      </p>
    </aside>
  </article>

  <section class="related" aria-labelledby="related-title">
    <h2 id="related-title">További írások</h2>
    <ul>
      {related.map((p) => (
        <li>
          <a href={`/blog/${p.id}`}>
            <Img src={p.data.cover} alt="" sizes="(max-width: 900px) 100vw, 340px" widths={[340, 680]} />
            <span>{p.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
