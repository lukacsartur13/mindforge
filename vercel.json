    },
    {
      "source": "/rólam",
      "destination": "/rolam",
      "permanent": true
    },
    {
      "source": "/blank",
      "destination": "/sikersztorik",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/adatkezelesi-nyilatkozat",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/impresszum",
      "permanent": true
    },
    {
      "source": "/programs",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/challenge-page/:id",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/categories/mentalis-pillerek",
      "destination": "/blog/kategoria/mentalis-pillerek",
