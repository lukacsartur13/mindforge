    },
    {
      "source": "/post/ment%C3%A1lis-pill%C3%A9rek-2-a-bels%C5%91-hang",
      "destination": "/blog/mentalis-pillerek-2-a-belso-hang",
      "permanent": true
    },
    {
      "source": "/post/ment%C3%A1lis-pill%C3%A9rek-3-nincs-fejl%C5%91d%C3%A9s-hiba-n%C3%A9lk%C3%BCl",
      "destination": "/blog/mentalis-pillerek-3-nincs-fejlodes-hiba-nelkul",
